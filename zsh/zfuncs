port() {
    if [[ $# == 0 ]]; then
        print 'Usage: port <int>'
        return
    fi
    case $(uname -s) in
        Darwin)
            for port in $@; do
                lsof -n -i4TCP:${port}
            done
            ;;
        Linux)
            # todo
            netstat -ntlp | grep $@ ;;
    esac
}

listen() {
    while true; do
        nc -l 127.0.0.1 $1
    done
}

# preview file
p() {
    if [[ $# == 0 ]]; then ww * ; fi
    if [[ $(uname -s) == 'Darwin' ]]; then
        qlmanage -p $@ >& /dev/null
    fi
}

# notify title text
# TODO: customize icon and click action
notify() {
    osascript -e "display notification \"$2\" with title \"$1\""
}

alert() {
    osascript \
        -e "tell application \"Terminal\"" \
        -e 'activate' \
        -e "display dialog \"$1\" with icon note" \
        -e 'end tell'
    # osascript -e 'display notification "iTerm icon" with icon alias "Applications:iTerm.app:Contents:Resources:AppIcon.icns"'
}

function ret() {
    local ret_code=$?
    echo $ret_code
    return $ret_code
}

function list_colors() {
	for color in $(seq 0 255)
	do
		for style in "38;5"
		do
			tag="\033[${style};${color}m"
			str="${style};${color}"
			echo -ne "${tag}${str}${NONE}  "
		done
		echo
	done
}

# TODO: include
function list_shared() {
    zsfs="$(brew --prefix)/share/zsh/site-functions"
    if [[ -d $zsfs ]]; then
        for zsf in $(ls $zsfs); do
            echo $zsf
        done
    fi
}

rosetta() {
    ps -p `fuser /usr/libexec/rosetta/runtime | sed -e 's/.*: //' | sed -e 's/ /,/g'`
}



