# vim: set ft=zsh:

alias d=docker

dre() {
    local dir=$(basename $PWD)

    docker run \
        --interactive \
        --tty \
        --rm \
        --hostname ${dir} \
        --volume $PWD:/${dir} \
        --workdir /${dir} \
        --cpus 3 \
        --memory $(bc <<< '6 * 1024^3') \
        --ulimit nofile=50000:50000 \
        $*
    # --publish port:port image
}

drun() {
    docker run --interactive --tty --rm $*
}

dgc() {
    docker system prune --force --all
    docker volume prune --force
}

env_docker() {
    docker_bins='/Applications/Docker.app/Contents/Resources/bin'
    [[ -d ${docker_bins} ]] && export PATH=${docker_bins}:$PATH
}

docker_cmds=(
    container
    image
    network
    system
    volume

    build
    commit
    exec
    images
    import
    info
    inspect
    kill
    login
    logs
    ps
    push
    rename
    restart
    rm
    rmi
    run
    save
    start
    stats
    stop
    tag
    top
    update
    wait
)
compctl -k docker_cmds docker
