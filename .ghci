-- https://github.com/github/semantic/blob/main/.ghci.sample

:set -fwarn-unused-binds
:set -fwarn-unused-imports

:set -ferror-spans
:set -freverse-errors
:set -fprint-expanded-synonyms

:seti -fbreak-on-error

:seti -XOverloadedStrings
:seti -XNumericUnderscores

-- :set -flocal-ghci-history

-- ƒ
-- TODO: modules
:set prompt "\ESC[1;36m\STX- \ESC[m\STX"


:def hoogle \str -> return $ ":!hoogle --count=15 \"" ++ str ++ "\""
